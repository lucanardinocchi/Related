# Public — exposed to the browser bundle. Same Supabase project as
# EXPO_PUBLIC_SUPABASE_* in src/mobile/.env.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# Messaging integrations (Settings → Integrations). Client IDs only — secrets
# live in Supabase Edge Function secrets. See docs/MESSAGING_INTEGRATIONS.md.
# NEXT_PUBLIC_INSTAGRAM_APP_ID=
# NEXT_PUBLIC_WHATSAPP_APP_ID=
# NEXT_PUBLIC_X_CLIENT_ID=
# NEXT_PUBLIC_TIKTOK_CLIENT_KEY=

# Outlook Calendar (optional; same pattern as messaging OAuth)
# NEXT_PUBLIC_MICROSOFT_CLIENT_ID=

# Stripe — server-only in src/web/.env.local (used by /api/billing/* routes):
#   STRIPE_SECRET_KEY=sk_...
#   STRIPE_PRICE_ID=price_...   # Recurring $29/month price in Stripe Dashboard
# Webhook (Supabase Edge Function secret): STRIPE_WEBHOOK_SECRET=whsec_...
# Deploy: supabase functions deploy stripe-webhook --no-verify-jwt

# Feedback form — server-only fallback when Gmail is not connected (Resend:
# https://resend.com). When Gmail is connected, feedback sends from the user's
# Gmail via the gmail-contact Edge Function.
#   RESEND_API_KEY=re_...
#   RESEND_FROM_EMAIL=Related <feedback@yourdomain.com>
#   FEEDBACK_TO_EMAIL=lucanardinocchi@gmail.com
