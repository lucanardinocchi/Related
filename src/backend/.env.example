# Copy to src/backend/.env (gitignored). Used by local Supabase Auth when running
# `supabase start` — see config.toml [auth.external.google] / [auth.external.apple].
#
# Hosted Supabase: set the same values in Dashboard → Authentication → Providers
# (Google / Apple). Do not commit real secrets.

# --- Google (Sign in with Google + Connect Calendar) ---
# From Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client (Web).
# Authorised redirect URI must include:
#   https://yawclybcwwtrrnuyotdm.supabase.co/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Apple (Sign in with Apple, web + native OAuth flow) ---
# Client ID = Services ID (e.g. com.related.web).
# Secret = JWT from scripts/generate-apple-auth-secret.mjs (rotate every 6 months).
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# --- Outlook Calendar (Microsoft Graph) — needed by `outlook-oauth`, `sync-calendar`, and `outlook-contact` edge functions. ---
# Register a Web app at https://portal.azure.com/ → Microsoft Entra ID → App registrations.
# Redirect URIs (Azure → Authentication → Web; must match NEXT_PUBLIC_APP_ORIGIN on web):
#   https://userelatedai.com/settings/outlook/callback
#   https://related-sooty.vercel.app/settings/outlook/callback
#   http://localhost:3000/settings/outlook/callback  (optional local dev)
# API permissions (delegated): Calendars.Read, Mail.Read, Mail.Send, User.Read, offline_access.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# --- Messaging (hosted: supabase secrets set …; see docs/MESSAGING_INTEGRATIONS.md) ---
# Instagram (Meta) — OAuth + Graph API + webhooks.
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=                # HMAC-SHA256 key for X-Hub-Signature-256 on inbound webhooks. REQUIRED in prod.
# INSTAGRAM_VERIFY_TOKEN=              # Echoed during Meta webhook GET handshake (hub.verify_token).
#
# WhatsApp Business (Meta) — Cloud API + webhooks.
# WHATSAPP_APP_ID=
# WHATSAPP_APP_SECRET=                 # HMAC-SHA256 key for X-Hub-Signature-256 on inbound webhooks. REQUIRED in prod.
# WHATSAPP_VERIFY_TOKEN=               # Echoed during Meta webhook GET handshake.
#
# X (Twitter)
# X (Twitter) DM endpoints require a paid X API tier (Basic or higher).
# Free tier accounts cannot read or send DMs via the API.
# X_CLIENT_ID=
# X_CLIENT_SECRET=
#
# TikTok Business Messaging.
# TIKTOK_CLIENT_KEY=                   # App client_key. When set, inbound webhooks MUST include matching client_key.
# TIKTOK_CLIENT_SECRET=
# TIKTOK_BUSINESS_ID=
# TIKTOK_VERIFY_TOKEN=                 # Reserved for GET challenge handshake; the webhook echoes ?challenge= unconditionally.
