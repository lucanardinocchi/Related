# Required for the app to boot at all.
# These are EXPO_PUBLIC_* so Expo's web bundler inlines them into the
# client bundle. Both are safe to expose publicly — the anon key is
# RLS-gated; the only thing it can do without a User session is sign up.
EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Optional for the first smoke test. Set after you provision a hosted
# Expo project via `npx eas init` — the projectId lands in app.json and
# is also exposed here so the push-notifications client knows which
# project to register against. Until you set this, the Onboarding
# notifications step renders as Skip-only.
# EXPO_PUBLIC_PROJECT_ID=<uuid>

# Optional. Set after you generate VAPID keys with
# `npx web-push generate-vapid-keys`. Until set, the web push
# registration step skips. The private key DOES NOT belong here —
# it goes in Supabase secrets (`VAPID_PRIVATE_KEY`).
# EXPO_PUBLIC_VAPID_PUBLIC_KEY=<base64-url-encoded-pubkey>
