{
  "name": "related",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "src/shared",
    "src/mobile",
    "src/web",
    "src/backend",
    "src/relay",
    "src/evals"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "build:web": "npm run build --workspace=@related/web",
    "test:e2e": "playwright test",
    "generate:values-media": "node src/backend/scripts/generate-values-media.mjs",
    "generate:values-missing": "node src/backend/scripts/generate-values-media.mjs --missing",
    "generate:values-launch": "node src/backend/scripts/generate-values-media.mjs --launch --force",
    "eval": "npm --prefix src/evals run eval --",
    "eval:view": "npm run eval:view --workspace=@related/evals"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
